import java.util.Scanner;
import java.util.Random;

public class CS102_HW_PART2 {
    public static void main(String[] args) {
        Scanner panel = new Scanner(System.in);
        System.out.print("Enter the size of your desired array: ");
        int kullanıcıGirilenBoyut = panel.nextInt();
        int[] rastgeleSayıArray = new int[kullanıcıGirilenBoyut];
        Random rastgeleArrayElemanları = new Random();


        for (int n = 0; n < kullanıcıGirilenBoyut; n++) {
            rastgeleSayıArray[n] = rastgeleArrayElemanları.nextInt(101);
        }



        int komut = 31;
        while (komut != ç) {
            System.out.println("Welcome to the user menu. Please select your command: ");
            System.out.println("a) Find the array's minimum and maximum ");
            System.out.println("b) Find the average of the array and see how far each element is from the average ");
            System.out.println("c) Find the sum of elements with odd and even numbered indexes ");
            System.out.println("Press ç for exit");

            komut = panel.nextInt();


            if (komut == a) {
                int enKüçükEleman = enKüçükBulucu(rastgeleSayıArray);
                int enBüyükEleman = enBüyükBulucu(rastgeleSayıArray);
                System.out.println("The minimum element is: " + enKüçükEleman);
                System.out.println("The maximum element is " + enBüyükEleman);
            }

            else if (komut == b) {
                double ortalama = Ortalayıcı(rastgeleSayıArray);
                
                double[] ortalamadanSapmalar = sapmalarıBul(rastgeleSayıArray, ortalama);

                System.out.println("The average of the array is: " + ortalama);
                System.out.println("Each element differs from the average is: ( ");
                for (int x = 0; x < ortalamadanSapmalar.length-1; x++) {
                    System.out.print(ortalamadanSapmalar[x] + ",");
                }
                System.out.print(ortalamadanSapmalar[ortalamadanSapmalar.length-1] + ")");


            }

            else if (komut == c) {
                int tekSıradakilerToplamı = tekleriTopla(rastgeleSayıArray);
                int çiftSıradakilerToplamı = çiftleriTopla(rastgeleSayıArray);
                System.out.print("Odd indexes sum is " + tekSıradakilerToplamı + ", Even indexes sum is " + çiftSıradakilerToplamı);


            }

            else if (komut == ç) {
                System.out.println("You are logging out of the program");

            }


        }
    }
    panel.close();






    //metodlar
    public static int enKüçükBulucu(int[] rastgeleSayıArray) {
        int enKüçük = rastgeleSayıArray[0];
        for (int p = 1; p < rastgeleSayıArray.length; p++) {
            if (rastgeleSayıArray[p] < enKüçük) {
                enKüçük = rastgeleSayıArray[p];
            }
        
        }
        return enKüçük;
    }

    public static int enBüyükBulucu(int[] rastgeleSayıArray) {
        int enBüyük = rastgeleSayıArray[0];
        for (int q=1; q < rastgeleSayıArray.length; q++) {
            if (rastgeleSayıArray[q] > enBüyük) {
                enBüyük = rastgeleSayıArray[q];
            }
        }
        return enBüyük;
    }


    public static double Ortalayıcı(int[] rastgeleSayıArray) {
        double elemanlarıToplamı = 0;
        for (a = 0; a < rastgeleSayıArray.length; a++) {
            elemanlarıToplamı += rastgeleSayıArray[a];
        }
        double ortalama = elemanlarıToplamı / rastgeleSayıArray;
        return ortalama;
    }
    
    public static int tekleriTopla (int[] rastgeleSayıArray) {
        int tekToplam = 0;
        for(t = 1; t < rastgeleSayıArray.length; t+=2) {
            tekToplam += rastgeleSayıArray[t];
        }
        return tekToplam;
    }

    public static int çiftleriTopla(int[] rastgeleSayıArray) {
        int çiftToplam = 0;
        for(ç = 0; ç < rastgeleSayıArray.length; ç+=2) {
            çiftToplam += rastgeleSayıArray[ç];
        }
        return çiftToplam;
    }

    public static double[] sapmalarıBul(int rastgeleSayıArray[], double ortalama) {
        double ortalamadanSaplamalar = new double[rastgeleSayıArray.length];
        for (int s = 0; s < rastgeleSayıArray.length; s++) {
            double sapma = rastgeleSayıArray[s] - ortalama;
            ortalamadanSapmalar[s] = sapma;
        }
        return ortalamadanSapmalar;
    }
}